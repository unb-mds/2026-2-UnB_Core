# Banco de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unb_core
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/unb_core

JWT_SECRET_KEY=dev-only-change-this-secret-key-32-bytes-minimum

# Endereços do site que podem chamar a API, separados por vírgula (na publicação).
# Sem valor, vale o front local (localhost:5173).
CORS_ORIGINS=

# Administrador inicial (opcional; nunca versione os valores reais)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

